{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject"
            ],
            "Resource": [
                "arn:aws:s3:::askul-sandbox-01-regulation-test-bucket/*",
                "arn:aws:s3:::askul-sandbox-01-regulation-step-functions-bucket/*"
            ]
        },
        {
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket"
            ],
            "Resource": "arn:aws:s3:::askul-sandbox-01-regulation-test-bucket"
        },
        {
            "Effect": "Allow",
            "Action": [
                "lambda:InvokeFunction"
            ],
            "Resource": [
                "arn:aws:lambda:ap-northeast-1:902163356275:function:keywords-checker-lambda2",
                "arn:aws:lambda:ap-northeast-1:902163356275:function:keywords-checker-splitter",
                "arn:aws:lambda:ap-northeast-1:902163356275:function:keywords-checker-processor",
                "arn:aws:lambda:ap-northeast-1:902163356275:function:keywords-checker-combiner"
            ]
        },
        {
            "Effect": "Allow",
            "Action": [
                "logs:PutLogEvents",
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:CreateLogDelivery",
                "logs:GetLogDelivery",
                "logs:UpdateLogDelivery",
                "logs:DeleteLogDelivery",
                "logs:ListLogDeliveries",
                "logs:PutResourcePolicy",
                "logs:DescribeResourcePolicies",
                "logs:DescribeLogGroups"
            ],
            "Resource": "*"
        },
        {
            "Effect": "Allow",
            "Action": "states:StartExecution",
            "Resource": "arn:aws:states:ap-northeast-1:902163356275:stateMachine:keywords-checker-state-machine"
        }
    ]
}